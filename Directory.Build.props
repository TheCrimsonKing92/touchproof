<Project>
  <PropertyGroup>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <UseSharedCompilation>false</UseSharedCompilation>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\artifacts\**;**/artifacts/**;**\.scratch\**;**/.scratch/**</DefaultItemExcludes>
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);**\artifacts\**;**/artifacts/**;**\.scratch\**;**/.scratch/**</DefaultItemExcludesInProjectFolder>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
  <!-- Restore output may record the root as $(UserProfile), and builds can run under a different profile. -->
  <PropertyGroup>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == '' and '$(NUGET_PACKAGES)' != ''">$([MSBuild]::EnsureTrailingSlash('$(NUGET_PACKAGES)'))</NuGetPackageRoot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AuditPipeline)' == 'true'">
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(McgIsolatedArtifactsPath)' != ''">
    <!-- Keep native MTP build outputs isolated without setting the SDK-reserved ArtifactsPath.
         .NET 10 forwards ArtifactsPath to the test app as an artifacts-path option, which xUnit MTP v2
         3.2.2 does not accept. Project-scoped base paths preserve isolation without changing the
         test application's argument vector. The project-name segment is also the manifest and
         reusable-artifact lookup contract. -->
    <BaseOutputPath>$(McgIsolatedArtifactsPath)\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(McgIsolatedArtifactsPath)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\bin\**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- Short-lived processes rarely recover dynamic PGO instrumentation costs: capture profiling helpers used 12.8 of 223.7 dotnet CPU-seconds (5.7%).
       Core tests averaged 95.4 to 87.6 CPU-seconds with PGO off (about 8% less, indicative). -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Mcg.AgentOrchestrator.App' or '$(MSBuildProjectName)' == 'Mcg.AgentOrchestrator.RealProcessShardProbe' or ($(MSBuildProjectName.StartsWith('Mcg.AgentOrchestrator.')) and $(MSBuildProjectName.EndsWith('.Tests')))">
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
</Project>
